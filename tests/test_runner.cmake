# Exercise runner failures against disposable fixtures, never the source tree.
set(work "${CMAKE_CURRENT_BINARY_DIR}/runner-checks")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/fixtures/vertex" "${work}/fixtures/fragment")
foreach(name glsl140-basic-in.txt glsl140-basic-out.txt)
    file(COPY "${TEST_SOURCE_DIR}/vertex/${name}" DESTINATION "${work}/fixtures/vertex")
endforeach()
foreach(name basic-in.txt basic-out.txt glsl120-basic-inES3.txt glsl120-basic-outES3.txt glsl120-basic-outES3Metal.txt)
    file(COPY "${TEST_SOURCE_DIR}/fragment/${name}" DESTINATION "${work}/fixtures/fragment")
endforeach()

# Compute inputs use the same golden-output and roundtrip checks as graphics.
file(MAKE_DIRECTORY "${work}/fixtures/compute")
foreach(name workgroup-layout-in.txt workgroup-layout-out.txt)
    file(COPY "${TEST_SOURCE_DIR}/compute/${name}" DESTINATION "${work}/fixtures/compute")
endforeach()

function(check_run expected_result expected_message)
    execute_process(COMMAND "${TEST_RUNNER}" ${ARGN}
        WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "${expected_result}" OR NOT output MATCHES "${expected_message}")
        message(FATAL_ERROR "Unexpected runner result (${result}):\n${output}\n${error}")
    endif()
endfunction()

check_run(0 "4 tests.*succeeded" "${work}/fixtures")
check_run(1 "Could not read test directory" "${work}/missing")
file(MAKE_DIRECTORY "${work}/empty/vertex" "${work}/empty/fragment" "${work}/empty/compute")
check_run(1 "No shader inputs" "${work}/empty")
check_run(1 "USAGE:")
check_run(1 "Unknown option" "${work}/fixtures" --unknown)

set(expected "${work}/fixtures/fragment/basic-out.txt")
file(READ "${expected}" original)
string(REPLACE "\r\n" "\n" original "${original}")
file(WRITE "${expected}" "deliberately incorrect\n")
check_run(1 "does not match optimized output" "${work}/fixtures")
file(READ "${expected}" unchanged)
if(NOT unchanged STREQUAL "deliberately incorrect\n")
    message(FATAL_ERROR "A failed comparison modified its expectation")
endif()
set(actual "${work}/test-output/fragment/basic-out.txt.actual")
file(READ "${actual}" actual_text)
if(NOT actual_text STREQUAL original)
    message(FATAL_ERROR "Mismatch diagnostics did not contain the actual shader output")
endif()

file(REMOVE "${expected}")
check_run(1 "missing or unreadable expected output" "${work}/fixtures")
if(EXISTS "${expected}")
    message(FATAL_ERROR "A missing expectation was silently created")
endif()
check_run(0 "Updated" "${work}/fixtures" --update-expected)
file(READ "${expected}" updated)
if(NOT updated STREQUAL original)
    message(FATAL_ERROR "Explicit expectation update wrote incorrect output")
endif()
check_run(0 "4 tests.*succeeded" "${work}/fixtures")

# Empty files must be read safely, and Metal expectations are required on all OSes.
file(WRITE "${expected}" "")
check_run(1 "does not match optimized output" "${work}/fixtures")
file(WRITE "${expected}" "${original}")
file(REMOVE "${work}/fixtures/fragment/glsl120-basic-outES3Metal.txt")
check_run(1 "missing or unreadable expected output.*outES3Metal" "${work}/fixtures")

# Restore the Metal expectation removed by the preceding failure check.
file(COPY "${TEST_SOURCE_DIR}/fragment/glsl120-basic-outES3Metal.txt"
    DESTINATION "${work}/fixtures/fragment")
check_run(0 "4 tests.*succeeded" "${work}/fixtures")
set(compute_input "${work}/fixtures/compute/workgroup-layout-in.txt")
file(READ "${compute_input}" compute_source)
string(REPLACE "layout(local_size_x=8, local_size_y=4) in;" "" no_layout "${compute_source}")
string(REPLACE "gl_WorkGroupSize.z" "1u" no_layout "${no_layout}")
file(WRITE "${compute_input}" "${no_layout}")
check_run(1 "compute shader must contain a fixed or a variable local group size" "${work}/fixtures")
file(WRITE "${compute_input}" "${compute_source}")

# Out-of-range resource bindings fail in the frontend.
set(resource_input "${work}/fixtures/compute/resource-binding-inES3.txt")
function(check_resource_binding declaration last_binding invalid_binding backend_message frontend_message)
    foreach(binding ${last_binding} ${invalid_binding})
        string(REPLACE "BINDING" "${binding}" resource "${declaration}")
        file(WRITE "${resource_input}" "#version 310 es\n${resource}\nlayout(local_size_x=1) in;\nvoid main() {}\n")
        if(binding EQUAL last_binding)
            if(backend_message STREQUAL "")
                check_run(0 "succeeded" "${work}/fixtures" --update-expected)
            else()
                check_run(1 "${backend_message}" "${work}/fixtures")
            endif()
        else()
            check_run(1 "${frontend_message}" "${work}/fixtures")
        endif()
    endforeach()
endfunction()
check_resource_binding("layout(r32ui, binding=BINDING) uniform highp uimage2D data;"
    7 8 "" "maximum number of image units")
check_resource_binding("layout(binding=BINDING, offset=0) uniform atomic_uint counter;"
    7 8 "" "maximum number of atomic counter buffer bindings")
file(WRITE "${compute_input}" "${compute_source}")
file(REMOVE "${resource_input}" "${work}/fixtures/compute/resource-binding-outES3.txt" "${work}/fixtures/compute/resource-binding-outES3Metal.txt")

# Check uniform-block output at the highest valid binding and reject the next binding.
set(resource_input "${work}/fixtures/compute/uniform-binding-in.txt")
foreach(binding 71 72)
    file(WRITE "${resource_input}" "#version 430\nlayout(std140, binding=${binding}) uniform Data { uint value; } data;\nlayout(local_size_x=1) in;\nvoid main() { barrier(); }\n")
    if(binding EQUAL 71)
        check_run(0 "succeeded" "${work}/fixtures" --update-expected)
        check_run(0 "succeeded" "${work}/fixtures")
    else()
        check_run(1 "maximum number of UBO binding points" "${work}/fixtures")
    endif()
endforeach()
file(REMOVE "${resource_input}" "${work}/fixtures/compute/uniform-binding-out.txt")

# SSBO binding limits apply independently of UBO binding limits.
set(resource_input "${work}/fixtures/compute/storage-binding-in.txt")
foreach(binding 15 16)
    file(WRITE "${resource_input}" "#version 430\nlayout(std430, binding=${binding}) buffer Data { uint value; } data;\nlayout(local_size_x=1) in;\nvoid main() { data.value = gl_GlobalInvocationID.x; }\n")
    if(binding EQUAL 15)
        check_run(0 "succeeded" "${work}/fixtures" --update-expected)
        check_run(0 "succeeded" "${work}/fixtures")
    else()
        check_run(1 "maximum number of SSBO binding points" "${work}/fixtures")
    endif()
endforeach()
file(REMOVE "${resource_input}" "${work}/fixtures/compute/storage-binding-out.txt")

# Unsupported buffer operations must fail instead of producing invalid Metal.
function(check_storage_rejection declaration body diagnostic)
    set(input "${work}/fixtures/fragment/storage-reject-inES3.txt")
    file(WRITE "${input}" "#version 310 es\nprecision highp float;\n${declaration}\nout vec4 color;\nvoid main() { ${body} }\n")
    check_run(1 "${diagnostic}" "${work}/fixtures" --update-expected)
    check_run(1 "${diagnostic}" "${work}/fixtures")
    file(REMOVE "${input}" "${work}/fixtures/fragment/storage-reject-outES3.txt")
endfunction()
check_storage_rejection("layout(std430) coherent buffer Data { float value; } data;"
    "data.value = 1.0; color = vec4(data.value);" "Metal coherent/volatile storage buffers")


# Shared types and atomic widths must match Metal's threadgroup representation.
set(compute_reject "${work}/fixtures/compute/workgroup-reject-inES3.txt")
file(WRITE "${compute_reject}" "#version 310 es\nlayout(local_size_x=4) in;\nshared mediump uint value;\nvoid main() { atomicAdd(value, 1u); }\n")
check_run(1 "Metal shared atomics require highp" "${work}/fixtures" --update-expected)
foreach(precision mediump lowp)
    foreach(target "value.yx[gl_LocalInvocationIndex & 1u]" "value.yxyx.wzyx[gl_LocalInvocationIndex]")
        file(WRITE "${compute_reject}" "#version 310 es\nlayout(local_size_x=4) in;\nshared ${precision} uvec2 value;\nvoid main() { atomicAdd(${target}, 1u); }\n")
        check_run(1 "Metal shared atomics require highp" "${work}/fixtures" --update-expected)
    endforeach()
endforeach()
file(WRITE "${compute_reject}" "#version 310 es\nlayout(local_size_x=4) in;\nstruct Entry { mediump ivec2 value[2]; };\nshared Entry entries[4];\nvoid main() { atomicCompSwap(entries[gl_LocalInvocationIndex].value[1].yx[gl_LocalInvocationIndex & 1u], 0, 1); }\n")
check_run(1 "Metal shared atomics require highp" "${work}/fixtures" --update-expected)
file(WRITE "${compute_reject}" "#version 310 es\nlayout(local_size_x=4) in;\nshared mat2 value;\nvoid main() { value = mat2(1.0); barrier(); }\n")
check_run(1 "Shared-variable type output is not supported" "${work}/fixtures" --update-expected)
file(REMOVE "${compute_reject}" "${work}/fixtures/compute/workgroup-reject-outES3.txt")

