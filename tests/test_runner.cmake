check_run(1 "Volatile image" "${work}/fixtures" --update-expected)
foreach(call "storeValue(value, ivec2(0))" "forwardStore(value, ivec2(0))")
    file(WRITE "${image_reject}" "#version 310 es\nlayout(local_size_x=1) in;\nlayout(r32ui) uniform writeonly highp uimage2D value;\nvoid storeValue(volatile writeonly highp uimage2D image, ivec2 p) { imageStore(image, p, uvec4(1u)); }\nvoid forwardStore(writeonly highp uimage2D image, ivec2 p) { storeValue(image, p); }\nvoid main() { ${call}; }\n")
    check_run(1 "Volatile image" "${work}/fixtures" --update-expected)
endforeach()
file(WRITE "${image_reject}" "#version 310 es\nlayout(local_size_x=1) in;\nlayout(r32ui) uniform highp uimage2D value[2];\nvoid main() { imageStore(value[1], ivec2(0), uvec4(1u)); }\n")
check_run(1 "Image dimension or resource-array" "${work}/fixtures" --update-expected)
